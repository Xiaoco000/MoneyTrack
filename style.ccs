:root {
  --primary: #10b981; /* Hijau Segar */
  --bg-color: #f8fafc;
  --card-bg: #ffffff;
  --text-dark: #0f172a;
  --text-muted: #64748b;
  --danger: #ef4444;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  font-family: 'Segoe UI', Roboto, sans-serif;
}

body {
  background-color: #cbd5e1;
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 100vh;
}

.app-container {
  width: 100%;
  max-width: 430px;
  height: 100vh;
  max-height: 932px;
  background-color: var(--bg-color);
  display: flex;
  flex-direction: column;
  position: relative;
  box-shadow: 0 10px 25px rgba(0,0,0,0.1);
  overflow: hidden;
}

/* Header */
.app-header {
  padding: 16px 20px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: var(--card-bg);
  border-bottom: 1px solid #f1f5f9;
}

.user-info { display: flex; align-items: center; gap: 10px; }
.avatar { width: 36px; height: 36px; border-radius: 50%; background: #d1fae5; color: var(--primary); display: flex; align-items: center; justify-content: center; font-size: 18px; }
.greeting { font-size: 11px; color: var(--text-muted); }
.icon-btn { border: none; background: none; font-size: 20px; color: var(--text-muted); cursor: pointer; }

/* Main Area */
.content-area {
  flex: 1;
  overflow-y: auto;
  padding: 16px 20px 100px 20px;
}

.page { display: none; }
.page.active { display: block; }

/* Dashboard Card */
.summary-card { background: #1e293b; color: #fff; padding: 20px; border-radius: 16px; margin-bottom: 20px; }
.card-label { font-size: 12px; color: #94a3b8; }
.summary-card h2 { font-size: 28px; margin: 6px 0 16px 0; }
.stats-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; border-top: 1px solid #334155; padding-top: 12px; }
.stat-item { display: flex; align-items: center; gap: 8px; font-size: 12px; }
.stat-item i { font-size: 22px; }
.stat-item.income i { color: #34d399; }
.stat-item.expense i { color: #f87171; }
.stat-item p { font-weight: bold; font-size: 13px; margin-top: 2px; }

.section-header { display: flex; justify-content: space-between; align-items: center; margin: 16px 0 10px 0; }
.section-title { font-size: 15px; font-weight: 600; color: var(--text-dark); }
.see-all { font-size: 12px; color: var(--primary); text-decoration: none; }

/* Transaksi List */
.transaction-list { list-style: none; display: flex; flex-direction: column; gap: 10px; }
.tx-item { background: var(--card-bg); padding: 12px; border-radius: 12px; border: 1px solid #f1f5f9; display: flex; justify-content: space-between; align-items: center; }
.tx-info h5 { font-size: 13px; color: var(--text-dark); margin-bottom: 2px; }
.tx-info span { font-size: 11px; color: var(--text-muted); }
.tx-amount { font-weight: bold; font-size: 13px; }
.tx-amount.income { color: var(--primary); }
.tx-amount.expense { color: var(--danger); }
.empty-state { text-align: center; color: var(--text-muted); font-size: 13px; padding: 30px 0; }

/* Filter Bar */
.filter-bar { display: flex; gap: 8px; margin-bottom: 12px; }
.filter-chip { padding: 6px 14px; border: 1px solid #e2e8f0; border-radius: 20px; background: var(--card-bg); font-size: 12px; color: var(--text-muted); cursor: pointer; }
.filter-chip.active { background: var(--primary); color: #fff; border-color: var(--primary); }

/* Feed Sosial */
.feed-list { display: flex; flex-direction: column; gap: 12px; margin-top: 10px; }
.feed-card { background: var(--card-bg); padding: 14px; border-radius: 12px; border: 1px solid #f1f5f9; }
.feed-header { display: flex; align-items: center; gap: 10px; margin-bottom: 8px; }
.avatar-sm { width: 32px; height: 32px; border-radius: 50%; background: #e0e7ff; color: #4338ca; display: flex; align-items: center; justify-content: center; font-weight: bold; font-size: 12px; }
.feed-author { font-size: 13px; color: var(--text-dark); display: block; }
.feed-time { font-size: 10px; color: var(--text-muted); }
.feed-content { font-size: 13px; color: #334155; line-height: 1.4; margin-bottom: 10px; }
.feed-actions { display: flex; gap: 15px; border-top: 1px solid #f1f5f9; padding-top: 8px; }
.feed-actions button { border: none; background: none; color: var(--text-muted); font-size: 11px; cursor: pointer; display: flex; align-items: center; gap: 4px; }

/* Profile Card */
.profile-card { background: var(--card-bg); padding: 16px; border-radius: 12px; border: 1px solid #f1f5f9; margin-top: 10px; font-size: 13px; line-height: 1.8; }

/* Floating Action Button (+) */
.fab-wrapper { position: absolute; bottom: 30px; left: 50%; transform: translateX(-50%); z-index: 10; display: flex; flex-direction: column; align-items: center; }
.fab-main { width: 56px; height: 56px; border-radius: 50%; background: var(--primary); color: #fff; border: 4px solid var(--bg-color); font-size: 26px; cursor: pointer; box-shadow: 0 4px 10px rgba(16, 185, 129, 0.4); transition: transform 0.3s; }
.fab-wrapper.active .fab-main { transform: rotate(45deg); background: var(--danger); }

.fab-menu { display: none; flex-direction: column; gap: 8px; position: absolute; bottom: 70px; width: 160px; }
.fab-wrapper.active .fab-menu { display: flex; }
.fab-item { padding: 10px; background: var(--card-bg); border: 1px solid #e2e8f0; border-radius: 8px; font-size: 12px; text-align: left; cursor: pointer; box-shadow: 0 4px 6px rgba(0,0,0,0.05); display: flex; align-items: center; gap: 6px; }

/* Bottom Nav */
.bottom-nav { position: absolute; bottom: 0; width: 100%; height: 65px; background: var(--card-bg); border-top: 1px solid #e2e8f0; display: flex; justify-content: space-around; align-items: center; }
.nav-item { border: none; background: none; display: flex; flex-direction: column; align-items: center; font-size: 10px; color: var(--text-muted); cursor: pointer; }
.nav-item i { font-size: 20px; margin-bottom: 2px; }
.nav-item.active { color: var(--primary); }
.nav-placeholder { width: 40px; }

/* Modal Form Pop-up */
.modal-overlay { position: absolute; top:0; left:0; right:0; bottom:0; background: rgba(0,0,0,0.5); display: none; justify-content: center; align-items: flex-end; z-index: 100; }
.modal-overlay.active { display: flex; }
.modal-content { background: #fff; width: 100%; padding: 20px; border-radius: 20px 20px 0 0; animation: slideUp 0.2s ease-out; }
.modal-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px; }
.close-btn { border: none; background: none; font-size: 24px; cursor: pointer; }

.type-selector { display: flex; gap: 10px; margin-bottom: 15px; }
.type-option { flex: 1; text-align: center; padding: 10px; border: 1px solid #e2e8f0; border-radius: 8px; font-size: 12px; cursor: pointer; }
.type-option input { display: none; }
.type-option:has(input:checked) { border-color: var(--primary); background: #ecfdf5; font-weight: bold; color: var(--primary); }

.form-group { margin-bottom: 12px; }
.form-group label { display: block; font-size: 11px; color: var(--text-muted); margin-bottom: 4px; }
.form-group input, .form-group select { width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 13px; }

.btn-primary { width: 100%; padding: 12px; background: var(--primary); color: #fff; border: none; border-radius: 8px; font-weight: bold; cursor: pointer; margin-top: 10px; }
.btn-sm { padding: 6px 12px; background: var(--primary); color: #fff; border: none; border-radius: 6px; font-size: 11px; cursor: pointer; }
.btn-danger { padding: 10px; background: var(--danger); color: #fff; border: none; border-radius: 8px; font-size: 12px; font-weight: bold; cursor: pointer; }

@keyframes slideUp { from { transform: translateY(100%); } to { transform: translateY(0); } }
